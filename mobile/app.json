{
  "expo": {
    "name": "EasySociety",
    "slug": "easysociety",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.easysociety.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E2725B"
      }
    },
    "extra": {
      "eas": {
        "projectId": "fba898bd-d818-4e26-a551-5caae6772a28"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
